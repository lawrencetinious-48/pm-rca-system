# Production environment example - copy to .env and fill values
# REQUIRED: strong random SECRET_KEY (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=replace-with-strong-hex-64
APP_ENV=production
SESSION_COOKIE_SECURE=1
REMEMBER_COOKIE_SECURE=1
PREFERRED_URL_SCHEME=https
PUBLIC_BASE_URL=https://your-domain.example
DATABASE_URL=postgresql+psycopg://pm_user:strongpassword@db:5432/pm_db
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
# Email alerts for watchdog and system reporting
ALERT_EMAIL_ADDRESS=lawrencemulindwa48@gmail.com
ALERT_EMAIL_PASSWORD=wzxo tnau aczd xmua
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=465
ALERT_SMTP_USE_SSL=1
ALERT_SMTP_USE_TLS=0
ALERT_EMAIL_TO=lawrencemulindwa48@gmail.com
REPORT_EMAIL=lawrencemulindwa48@gmail.com
WATCHDOG_SEND_PERIODIC_SUMMARY=0
# Set TRUSTED_PROXY_COUNT to the number of reverse proxy hops in front of this app (0 = direct)
TRUSTED_PROXY_COUNT=1
