# PM/RCA System Environment Configuration
# Copy this file to .env and fill in your values

# ================= DATABASE =================
POSTGRES_DB=pm_db
POSTGRES_USER=pm_user
POSTGRES_PASSWORD=changeme_please_set_strong_password

# Database URL (auto-generated if using docker-compose)
# DATABASE_URL=postgresql+psycopg://pm_user:changeme@localhost:5432/pm_db
DATABASE_URL=

# Optional dev database
# DEV_DATABASE_URL=postgresql+psycopg://pm_user:changeme@localhost:5432/pm_dev

# ================= SECURITY =================
# IMPORTANT: Generate a strong secret key!
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_very_long_secret_key_here_min_32_chars_change

# ================= APPLICATION =================
APP_ENV=production
APP_VERSION=1.0.0

# Session security (set to 1 in production with HTTPS)
SESSION_COOKIE_SECURE=0
REMEMBER_COOKIE_SECURE=0
PREFERRED_URL_SCHEME=http

# Public URL for link generation (e.g., https://yourdomain.com)
PUBLIC_BASE_URL=http://localhost:5001

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ================= REDIS =================
# Redis URL for caching and session storage
REDIS_URL=redis://redis:6379/0

# ================= EMAIL =================
# Email configuration for alerts and notifications
# For Gmail, use an App Password (requires 2FA enabled on the account).
ALERT_EMAIL_ADDRESS=lawrencemulindwa48@gmail.com
ALERT_EMAIL_PASSWORD=wzxo tnau aczd xmua
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=465
ALERT_SMTP_USE_SSL=1
ALERT_SMTP_USE_TLS=0

# ================= MONITORING =================
# Enable Prometheus metrics
PROMETHEUS_METRICS_ENABLED=true

# Watchdog configuration
WATCHDOG_ENABLED=true
WATCHDOG_INTERVAL=300  # Check every 5 minutes
WATCHDOG_RESPONSE_TIME_THRESHOLD=2.0  # 2 seconds max
WATCHDOG_CPU_THRESHOLD=90.0
WATCHDOG_MEMORY_THRESHOLD=90.0
WATCHDOG_DISK_THRESHOLD=90.0
WATCHDOG_ERROR_RATE_THRESHOLD=0.05  # 5% error rate
WATCHDOG_SEND_PERIODIC_SUMMARY=0

# Daily report configuration
# Use REPORT_INTERVAL_MINUTES for unified Watchdog AI reports every 90 minutes.
# REPORT_TIME remains available as a fallback when interval mode is not used.
REPORT_INTERVAL_MINUTES=90
REPORT_TIME=09:00
REPORT_EMAIL=lawrencemulindwa48@gmail.com
REPORT_RETENTION_DAYS=30

# ================= RATE LIMITING =================
# Max login attempts
MAX_LOGIN_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900  # 15 minutes
LOGIN_LOCKOUT_SECONDS=900  # 15 minutes

# ================= FILE UPLOADS =================
MAX_CONTENT_LENGTH=256  # MB (max upload size)
MAX_PHOTO_MB=10  # Max per photo

# ================= PERFORMANCE =================
# Enable inline automations (auto-scanning, etc.)
ENABLE_INLINE_AUTOMATIONS=1

# Maintenance interval in seconds
INLINE_MAINTENANCE_MIN_INTERVAL_SECONDS=120

# Access log for request tracking
ACCESS_LOG_ENABLED=1

# ================= CACHE TTLs =================
DASHBOARD_COUNT_CACHE_TTL=20
NOTIFICATION_BADGE_CACHE_TTL=8
PHOTO_LIBRARY_COUNT_CACHE_TTL=30
ACTIVITY_REVIEW_ROW_CACHE_TTL=45

# ================= PASSWORD =================
# Hash method: pbkdf2:sha256:150000 (iterations change for security)
PASSWORD_HASH_METHOD=pbkdf2:sha256:260000

# ================= DEVELOPMENT =================
# Flask debug mode (never enable in production)
FLASK_DEBUG=0

# For local development only
# Set DEV_DATABASE_URL if you want separate dev database
